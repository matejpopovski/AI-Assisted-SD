{
  "name": "lecture-3-tower-defense-lite",
  "version": "1.0.0",
  "description": "Lecture 3 practice project — TypeScript + p5.js tower defense game",
  "private": true,
  "main": "Main.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "run-p start-compile start-run",
    "start-compile": "tsc --watch",
    "start-run": "browser-sync start --server -w"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/p5": "^0.9.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "browser-sync": "^3.0.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "^4.0.5",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "p5": "^1.1.9"
  }
}
