{
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "env": {
        "browser": true,
        "es2020": true
    },
    "plugins": ["@typescript-eslint"],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "prettier"
    ],
    "rules": {
        "no-undef": "off",
        "no-console": "off",
        "@typescript-eslint/no-explicit-any": "warn"
    },
    "ignorePatterns": ["build/", "node_modules/"]
}
